{
  "name": "db-tool",
  "version": "0.1.0",
  "private": true,
  "author": "DB Tool",
  "description": "A local-first database management tool for MySQL and PostgreSQL",
  "main": "electron/main.cjs",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "npm --workspace server run build",
    "build:web": "npm --workspace web run build",
    "start": "node server/dist/index.js",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "npm --workspace server run typecheck && npm --workspace web run typecheck",
    "smoke": "node scripts/smoke-test.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "com.dbtool.desktop",
    "productName": "DB Tool",
    "copyright": "DB Tool",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/dist/**/*",
      "web/dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DB Tool",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  }
}
